<?xml version="1.0"?>
<package format="3">
  <name>joint_impedance_controller</name>
  <version>0.1.0</version>
  <description>
    A ROS 2 controller plugin for joint impedance control using effort commands and
    position, velocity, and effort state feedback.
  </description>

  <maintainer email="dongho@utexas.edu">dk</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pluginlib</buildtool_depend>

  <!-- Build dependencies -->
  <depend>controller_interface</depend>
  <depend>rclcpp</depend>
  <depend>control_msgs</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>pluginlib</depend>
  <depend>plato_interfaces</depend>
  <depend>plato_utils</depend>

  <!-- Runtime dependencies -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>plato_teleop</exec_depend>

  <!-- Test dependencies (if BUILD_TESTING is enabled) -->
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ros2_control_test_assets</test_depend>
  <test_depend>aristo_bringup</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <pluginlib plugin="controller_interface">
      <library path="libjoint_impedance_controller">
        <class name="joint_impedance_controller/JointImpedanceController"
               type="joint_impedance_controller::JointImpedanceController"
               base_class_type="controller_interface::ControllerInterface">
          <description>
            A joint impedance controller that uses effort commands and feedback from
            position, velocity, and effort states.
          </description>
        </class>
      </library>
    </pluginlib>
  </export>
</package>
