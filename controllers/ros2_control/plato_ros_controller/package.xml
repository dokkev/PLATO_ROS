<?xml version="1.0"?>
<package format="3">
  <name>plato_ros_controller</name>
  <version>0.1.0</version>
  <description>ROS 2 control plugin bridge for Plato control architecture and tactile sensing.</description>

  <maintainer email="dongho@utexas.edu">dk</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pluginlib</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>aristo_controller</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>plato_interfaces</depend>
  <depend>plato_robot_system</depend>
  <depend>sdr_grasp_msgs</depend>

  <exec_depend>controller_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <pluginlib plugin="controller_interface">
      <library path="plato_ros_controller">
        <class name="plato_ros_controller/PlatoRosController"
               type="plato_ros_controller::PlatoRosController"
               base_class_type="controller_interface::ControllerInterface">
          <description>
            ControlArchitecture-backed ros2_control controller with NARITouch topic subscribers.
          </description>
        </class>
      </library>
    </pluginlib>
  </export>
</package>
