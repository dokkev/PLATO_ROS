<?xml version="1.0"?>
<robot name="optimo" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Include the Xacro files -->
    <xacro:include filename="optimo_xacro/optimo_description.xacro" />
    <xacro:include filename="optimo_xacro/pedestal.xacro" />

    <!-- Include gz configuration -->
    <!-- <xacro:include filename="optimo_xacro/optimo.gz.xacro" /> -->

    <!-- World Link -->
    <link name="world"/>

    <!-- Pedestal -->
    <xacro:pedestal_description connector_link="world" />
    <!-- Optimo Arm -->
    <xacro:optimo_description connector_link="stand_link"/>


</robot>