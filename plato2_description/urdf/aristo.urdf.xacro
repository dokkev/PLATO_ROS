<?xml version="1.0"?>
<robot name="aristo_hand" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Root link for TF tree -->
  <link name="world"/>

  <!-- Includes -->
    <xacro:include filename="$(find plato2_description)/urdf/xacro/aristo_description.xacro"/>
    <xacro:include filename="$(find plato2_description)/urdf/ros2_control/aristo.ros2_control.xacro"/>


  <!-- Instantiate geometry/tree and ros2_control -->
  <xacro:aristo_description connector_link="world" xyz="0 0 0" rpy="0 0 0"/>
  <xacro:aristo_ros2_control name="aristo_ros2_control"/>

</robot>
