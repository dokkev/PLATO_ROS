      <origin xyz="-1.83214e-05 0.00935465 -0.0235065" rpy="-2.11359e-14 5.96582e-15 3.14159"/>
      <geometry>
        <mesh filename="file://$(find plato2_description)/meshes/thumb_actuators.stl"/>
      </geometry>
    </collision>
