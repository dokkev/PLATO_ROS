    <inertial>
      <origin xyz="0.0310493 7.38178e-05 -0.0024697" rpy="0 0 0"/>
      <mass value="0.0339468"/>
      <inertia ixx="1.73073e-06" ixy="-6.44674e-08" ixz="4.16261e-08" iyy="1.78285e-05" iyz="-2.33942e-10" izz="1.79881e-05"/>
    </inertial>
