      <material name="thumb_metacarpal_parts_material">
        <color rgba="0.582731 0.582731 0.582731 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0331527 5.31963e-05 0.0202412" rpy="1.80411e-16 -1.5708 0"/>
      <geometry>
        <mesh filename="file://$(find plato2_description)/meshes/thumb_metacarpal.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- Link thumb_actuators -->
