<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">    
<xacro:macro name="plato2_description" params="connector_link  xyz:='0 0 0'  rpy:='0 0 0' ">
  
  <!-- Link hand_base -->
  <link name="hand_base">
    <inertial>
      <origin xyz="0.0710032 0.00419305 0.0153006" rpy="0 0 0"/>
      <mass value="0.799163"/>
      <inertia ixx="0.000825527" ixy="0.000134393" ixz="-0.000212961" iyy="0.00124275" iyz="6.12778e-05" izz="0.00159582"/>
    </inertial>
    <!-- Part hand_base_parts -->
    <visual>
      <origin xyz="0.0710032 0.00419305 0.0153006" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="file://$(find plato2_description)/meshes/hand_base.stl"/>
      </geometry>
      <material name="hand_base_parts_material">
        <color rgba="0.598467 0.599053 0.600631 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0710032 0.00419305 0.0153006" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="file://$(find plato2_description)/meshes/hand_base.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- Link thumb_metacarpal -->
  <link name="thumb_metacarpal">
    <inertial>
      <origin xyz="0.0331527 5.31963e-05 0.0202412" rpy="0 0 0"/>
      <mass value="0.106079"/>
      <inertia ixx="2.85968e-05" ixy="-2.76218e-08" ixz="-4.28002e-07" iyy="3.69471e-05" iyz="7.39826e-09" izz="2.50051e-05"/>
