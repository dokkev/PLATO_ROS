    <inertial>
      <origin xyz="-1.83214e-05 0.00935465 -0.0235065" rpy="0 0 0"/>
      <mass value="0.22815"/>
      <inertia ixx="4.53556e-05" ixy="2.34195e-05" ixz="3.62997e-08" iyy="0.000164951" iyz="1.07283e-06" izz="0.000150958"/>
    </inertial>
    <!-- Part thumb_actuators_parts -->
    <visual>
      <origin xyz="-1.83214e-05 0.00935465 -0.0235065" rpy="-2.11359e-14 5.96582e-15 3.14159"/>
      <geometry>
        <mesh filename="file://$(find plato2_description)/meshes/thumb_actuators.stl"/>
