      <origin xyz="-0.0260847 0.00203273 -0.00249403" rpy="0 0 0"/>
      <mass value="0.0246538"/>
      <inertia ixx="1.51968e-06" ixy="-1.09639e-06" ixz="-6.8818e-09" iyy="1.06e-05" iyz="-2.50208e-09" izz="1.0688e-05"/>
