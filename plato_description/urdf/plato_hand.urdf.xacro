<?xml version="1.0"?>
<robot name="plato_hand" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Arguments -->
    <xacro:arg name="mock_hardware" default="false" />
    <xacro:arg name="gazebo_classic" default="false" />
    <xacro:arg name="gazebo" default="true" />
    <xacro:arg name="simulation_controllers" default="" />



    <!-- Set World Frame -->
    <link name="world"/>

    <!-- Include Xacro -->
    <xacro:include filename="$(find plato_description)/urdf/plato_xacro/plato_hand_description.xacro"/>
    <xacro:include filename="$(find plato_description)/urdf/plato_xacro/plato.transmission.xacro"/>
    <xacro:include filename="$(find plato_description)/urdf/plato_xacro/plato.ros2_control.xacro"/>

    <!-- Plato Hand -->
    <xacro:plato_description connector_link="world"/>
    <!-- Plato Hand Ros2 Control -->
    <xacro:plato_ros2_control name="plato_hand_controller"
                              mock_hardware="$(arg mock_hardware)"
                              gazebo_classic="$(arg gazebo_classic)"
                              gazebo ="$(arg gazebo)"/>





</robot>