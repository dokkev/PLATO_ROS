<?xml version="0.06.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="plato_ros2_control" params="
                                                name
                                                mock_hardware:=^|false
                                                gazebo_classic:=^|false
                                                gazebo:=^|false"
                                                >
                                                
  

    <ros2_control name="${name}" type="system">
        <hardware>

            <xacro:if value="${mock_hardware}">
                <plugin>mock_componets/GenericSystem</plugin>
            </xacro:if>

            <xacro:if value="${gazebo_classic}">
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                <gazebo>
                    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                        <parameters>$(find plato_bringup)/config/plato_hand_controllers.yaml</parameters>
                    </plugin>
                </gazebo>
            </xacro:if>

            <xacro:if value="${gazebo}">
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </xacro:if>

            <xacro:unless value="${mock_hardware or gazebo_classic or gazebo}">
                <plugin>plato_hardware_interface/PLATOHardware</plugin>
            </xacro:unless>

        </hardware>

        <joint name="plato_joint0">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <command_interface name="position"/>

            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint1">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint2">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position">
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint3">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint4">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint5">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint6">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint7">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="plato_joint8">
            <command_interface name="effort">
                <param name="min">-0.06</param>
                <param name="max">0.06</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

  </xacro:macro>

</robot>
