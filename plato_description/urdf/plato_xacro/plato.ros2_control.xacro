<?xml version="0.06.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="plato_ros2_control" params="
                                                name
                                                gazebo_classic:=^|false"
                                                >


        <!-- Gazebo ROS2 Control Plugin -->
        <xacro:if value="${gazebo_classic}">
            <gazebo>
                <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                    <parameters>$(find plato_bringup)/config/plato_gazebo_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>                                      


        <ros2_control name="${name}" type="system">
            
            <!-- Hardware -->
            <hardware> 
                <xacro:if value="${gazebo_classic}">
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </xacro:if>

                <xacro:unless value="${gazebo_classic}">
                    <plugin>plato_hardware_interface/PLATOHardware</plugin>
                </xacro:unless>
            </hardware>


            <joint name="plato_joint0">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint1">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint2">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position">
                </state_interface>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint3">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint4">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint5">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint6">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint7">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>

            <joint name="plato_joint8">
                <command_interface name="effort">
                    <param name="min">-0.06</param>
                    <param name="max">0.06</param>
                </command_interface>
                <!-- <command_interface name="position"/> -->

                <state_interface name="position"/>
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            
        </ros2_control>

  </xacro:macro>

</robot>
