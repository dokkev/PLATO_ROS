<robot name="plato">

    <!-- Base Link -->
    <link name="plato_base_link">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
        <mesh filename="file://$(find plato_description)/meshes/plato/plato_base_link_visual.stl"/>
        </geometry>
        <material name="plato_base_link_material">
        <color rgba="0.92522325716667042084 0.93028137847967418139 0.9333162512674763045 1.0"/>
        </material>
        </visual>
        <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
        <mesh filename="file://$(find plato_description)/meshes/plato/plato_base_link_collision.stl"/>
        </geometry>
        </collision>
        <inertial>
        <origin xyz="0.044024972902329512214 0.00072624824425259696531 -0.01069566578635177366" rpy="0 0 0"/>
        <mass value="0.1615803584199397569" />
