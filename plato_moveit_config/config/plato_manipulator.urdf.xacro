<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="plato_manipulator">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import plato_manipulator urdf file -->
    <xacro:include filename="$(find plato_description)/urdf/plato_hand.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="plato_manipulator.ros2_control.xacro" />


    <xacro:plato_manipulator_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
